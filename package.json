{
  "name": "maia-retro-tech-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build && tsx scripts/notices.ts",
    "start": "tsx apps/public-server/main.ts",
    "operator": "tsx apps/operator/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit:bundle && npm run test:e2e",
    "audit:secrets": "gitleaks git --redact && gitleaks dir --redact",
    "map:generate": "tsx scripts/map.ts",
    "audit:bundle": "tsx scripts/audit-bundle.ts",
    "scenes:generate": "tsx scripts/scenes.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "fastify": "5.12.7",
    "phaser": "3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.4"
  }
}
